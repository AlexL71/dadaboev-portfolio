---
import Layout from '../../../layouts/Layout.astro';

const projects = Object.values(import.meta.glob('./*.md', { eager: true })) as any[];
const sortedProjects = projects.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
const translations: Record<string, { title: string; description: string; category: string }> = {
  'north-american-road-data': { title: '북미 도로 데이터 구축 및 Auto-Labeling', description: 'Mapillary 수집, DINOv3 특징 벡터, FAISS 유사도 검색, 수동 검수 도구를 연결한 도로 이미지 구축 파이프라인입니다.', category: '데이터 파이프라인' },
  'amorphous-bottleneck': { title: '비정형 이상 탐지를 위한 재현율 최적화 앙상블', description: '낮은 대비와 불규칙한 형태를 가진 이상 객체를 안정적으로 찾기 위한 데이터 중심 앙상블 연구입니다.', category: '모델 아키텍처' },
  'omr-htr-digitization': { title: '오프라인 시험지 OMR·OCR 시스템', description: '시험지 정렬, 학생 연결, 답안 추출, 문자 인식, 결과 저장을 하나의 오프라인 흐름으로 구현합니다.', category: '응용 AI' },
  'road-damage-detection': { title: '도로 손상 세그멘테이션 및 심각도 분류', description: '불규칙한 균열을 폴리곤 마스크로 표현하고 탐지와 심각도 분류를 연결한 성능 인증 비전 파이프라인입니다.', category: '컴퓨터 비전' },
  'text-mining-fundamentals': { title: 'Python 텍스트 마이닝 실습 과정', description: '크롤링, 사전 분석, 토픽 모델링, LSTM 감성 분석을 다루는 프로젝트 중심 교육 자료입니다.', category: '자연어 처리' },
  'semantic-segmentation-modality-reduction': { title: '지식 증류 기반 경량 시맨틱 세그멘테이션', description: 'RGB·NIR·LiDAR 교사 모델의 지식을 RGB 전용 학생 모델로 전달해 센서 요구사항을 줄입니다.', category: '컴퓨터 비전' },
  'daily-doer-agent': { title: 'DailyDoer 텔레그램 자동화 에이전트', description: '일정, 이메일, 뉴스, 음성 명령을 하나의 대화형 인터페이스로 연결한 Python 기반 에이전트입니다.', category: '대화형 AI' },
  'local-llm-assistant': { title: '로컬 LLM 모바일 어시스턴트', description: 'PC에서 실행되는 로컬 언어 모델을 모바일 앱과 연결한 개인용 오프라인 AI 어시스턴트입니다.', category: '로컬 AI' },
  'autonomous-hexapod-robot': { title: '18자유도 헥사포드 로봇', description: '초음파 장애물 회피, 보행 제어, 전원 회로, 3D 프린팅 부품을 통합한 6족 보행 로봇입니다.', category: '로보틱스' },
  'autonomous-ball-launcher': { title: '비전 기반 자동 공 발사기', description: 'OpenCV 색상 추적, 서보 위치 제어, 초음파 거리 기반 모터 출력을 결합한 자동 발사 시스템입니다.', category: '임베디드 시스템' },
};
---

<Layout title="연구 및 프로젝트" description="다다버예브 압두라흐먼의 컴퓨터 비전, 데이터 시스템, 응용 머신러닝, 임베디드 엔지니어링 프로젝트입니다.">
  <header class="projects-header">
    <p class="eyebrow">연구 및 프로젝트</p>
    <h1>프로젝트</h1>
    <p>컴퓨터 비전, 데이터 시스템, 오프라인 AI, 임베디드 엔지니어링 분야의 연구와 개발 작업입니다.</p>
  </header>

  <div class="list-header"><span>프로젝트 {sortedProjects.length}개</span><span>최신순</span></div>

  <section class="project-list" aria-label="프로젝트">
    {sortedProjects.map((project) => {
      const slug = project.url.split('/').filter(Boolean).at(-1) as string;
      const copy = translations[slug] || project.frontmatter;
      return (
        <a href={project.url} class="project-row">
          <time>{project.frontmatter.date}</time>
          <div>
            <h2>{copy.title}</h2>
            <p>{copy.description}</p>
            <ul>{project.frontmatter.tags?.slice(0, 4).map((tag: string) => <li>{tag}</li>)}</ul>
          </div>
          <span class="category">{copy.category}</span>
        </a>
      );
    })}
  </section>

  <style>
    .projects-header { max-width: 48rem; padding-bottom: 2.2rem; }
    .projects-header h1 { margin-bottom: 0.5rem; word-break: keep-all; }
    .projects-header > p:last-child { font-size: 1.05rem; word-break: keep-all; }
    .list-header { display: flex; justify-content: space-between; margin-bottom: 0.9rem; color: var(--ink-muted); font-size: 0.84rem; }
    .project-list { display: grid; gap: 0.85rem; }
    .project-row { display: grid; grid-template-columns: 8rem minmax(0, 1fr) 10rem; gap: 1.5rem; align-items: start; padding: 1.4rem; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
    .project-row:hover h2 { color: var(--accent); }
    .project-row time, .category { color: var(--ink-muted); font-size: 0.84rem; }
    .category { text-align: right; }
    .project-row h2 { margin-bottom: 0.3rem; font-size: 1.18rem; word-break: keep-all; }
    .project-row p { max-width: 42rem; font-size: 0.96rem; word-break: keep-all; }
    .project-row ul { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; margin-top: 0.45rem; list-style: none; }
    .project-row li { color: var(--ink-muted); font-size: 0.8rem; }
    @media (max-width: 680px) { .project-row { grid-template-columns: 1fr; gap: 0.3rem; } .category { grid-row: 1; text-align: left; } .project-row time { grid-row: 1; justify-self: end; } }
  </style>
</Layout>
