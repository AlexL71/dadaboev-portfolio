---
import Layout from '../../layouts/Layout.astro';
import { projectSummaries } from '../../data/projectSummaries';

const projects = Object.values(import.meta.glob('./*.md', { eager: true })) as any[];
const sortedProjects = projects.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
const featuredSlugs = ['road-damage-detection', 'semantic-segmentation-modality-reduction', 'north-american-road-data', 'omr-htr-digitization'];
const getSlug = (project: any) => project.url.split('/').filter(Boolean).at(-1) as string;
const featuredProjects = featuredSlugs.map((slug) => sortedProjects.find((project) => getSlug(project) === slug)).filter(Boolean);
const additionalProjects = sortedProjects.filter((project) => !featuredSlugs.includes(getSlug(project)));
---

<Layout title="Research & Projects" description="Computer vision, data systems, applied machine learning, and embedded engineering projects by Abdurakhmon Dadaboev.">
  <header class="projects-header">
    <p class="eyebrow">Research & projects</p>
    <h1>Projects</h1>
    <p>Research and software work in computer vision, data systems, offline AI, and embedded engineering.</p>
  </header>

  <div class="list-header"><span>{sortedProjects.length} projects</span><span>Selected for AI and computer vision roles</span></div>

  <h2 class="group-title">Featured projects</h2>
  <section class="project-list" aria-label="Featured projects">
    {featuredProjects.map((project) => {
      const slug = getSlug(project);
      return (
        <a href={project.url} class="project-row featured">
          <time>{project.frontmatter.date}</time>
          <div><h2>{project.frontmatter.title}</h2><p>{projectSummaries.en[slug]?.result}</p></div>
          <span class="category">{project.frontmatter.category || 'Research'}</span>
        </a>
      );
    })}
  </section>

  <h2 class="group-title additional-title">Additional work</h2>
  <section class="project-list" aria-label="Additional projects">
    {additionalProjects.map((project) => (
      <a href={project.url} class="project-row compact">
        <time>{project.frontmatter.date}</time>
        <div><h2>{project.frontmatter.title}</h2><p>{project.frontmatter.description}</p></div>
        <span class="category">{project.frontmatter.category || 'Research'}</span>
      </a>
    ))}
  </section>

  <style>
    .projects-header { max-width: 48rem; padding-bottom: 2.2rem; }
    .projects-header h1 { margin-bottom: 0.5rem; }
    .projects-header > p:last-child { font-size: 1.05rem; }
    .list-header { display: flex; justify-content: space-between; margin-bottom: 0.9rem; color: var(--ink-muted); font-size: 0.84rem; }
    .group-title { margin: 1.6rem 0 0.9rem; font-size: 1.25rem; }
    .additional-title { margin-top: 3rem; }
    .project-list { display: grid; gap: 0.85rem; }
    .project-row { display: grid; grid-template-columns: 8rem minmax(0, 1fr) 10rem; gap: 1.5rem; align-items: start; padding: 1.4rem; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
    .project-row.featured { box-shadow: var(--shadow-md); }
    .project-row.compact { padding-block: 1.1rem; }
    .project-row:hover h2 { color: var(--accent); }
    .project-row time, .category { color: var(--ink-muted); font-size: 0.84rem; }
    .category { text-align: right; }
    .project-row h2 { margin-bottom: 0.3rem; font-size: 1.18rem; }
    .project-row p { max-width: 42rem; font-size: 0.96rem; }
    .project-row ul { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; margin-top: 0.45rem; list-style: none; }
    .project-row li { color: var(--ink-muted); font-size: 0.8rem; }
    @media (max-width: 680px) { .project-row { grid-template-columns: 1fr; gap: 0.3rem; } .category { grid-row: 1; text-align: left; } .project-row time { grid-row: 1; justify-self: end; } }
  </style>
</Layout>
