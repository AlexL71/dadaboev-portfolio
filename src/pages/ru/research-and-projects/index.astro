---
import Layout from '../../../layouts/Layout.astro';
import { projectSummaries } from '../../../data/projectSummaries';

const projects = Object.values(import.meta.glob('./*.md', { eager: true })) as any[];
const sortedProjects = projects.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
const featuredSlugs = ['road-damage-detection', 'semantic-segmentation-modality-reduction', 'north-american-road-data', 'omr-htr-digitization'];
const getSlug = (project: any) => project.url.split('/').filter(Boolean).at(-1) as string;
const featuredProjects = featuredSlugs.map((slug) => sortedProjects.find((project) => getSlug(project) === slug)).filter(Boolean);
const additionalProjects = sortedProjects.filter((project) => !featuredSlugs.includes(getSlug(project)));
const translations: Record<string, { title: string; description: string; category: string }> = {
  'north-american-road-data': { title: 'Подготовка и автоматическая разметка дорожных данных Северной Америки', description: 'Пайплайн на базе Mapillary с эмбеддингами DINOv3, поиском сходства в FAISS и ручной проверкой.', category: 'Подготовка данных' },
  'amorphous-bottleneck': { title: 'The Amorphous Bottleneck: ансамбль с приоритетом полноты', description: 'Исследование ансамбля для надёжного обнаружения низкоконтрастных аномалий неправильной формы.', category: 'Архитектура модели' },
  'omr-htr-digitization': { title: 'Офлайн-система OMR и HTR для экзаменационных работ', description: 'Единый офлайн-пайплайн для геометрического выравнивания, сопоставления студентов, распознавания ответов и сохранения результатов.', category: 'Прикладной ИИ' },
  'road-damage-detection': { title: 'Сегментация и оценка повреждений дорог', description: 'Полигональная разметка неровных трещин, сегментация и классификация степени повреждения.', category: 'Компьютерное зрение' },
  'text-mining-fundamentals': { title: 'Практический курс по анализу текста на Python', description: 'Проектные материалы по сбору текстов, словарному анализу, тематическому моделированию и LSTM.', category: 'Обработка текста' },
  'semantic-segmentation-modality-reduction': { title: 'Эффективная семантическая сегментация с дистилляцией знаний', description: 'Перенос знаний из модели-учителя с RGB, NIR и LiDAR в RGB-модель-ученик для снижения требований к датчикам.', category: 'Компьютерное зрение' },
  'daily-doer-agent': { title: 'DailyDoer Agent: диалоговый Telegram-бот', description: 'Python-агент для работы с календарём, электронной почтой, новостями и голосовыми командами.', category: 'Диалоговый ИИ' },
  'local-llm-assistant': { title: 'Мобильный помощник на базе локальной LLM', description: 'Приватный офлайн-помощник, соединяющий локальную модель на компьютере с мобильным приложением.', category: 'Локальный ИИ' },
  'autonomous-hexapod-robot': { title: 'Гексапод с 18 степенями свободы', description: 'Гексапод с походкой «трипод», ультразвуковым обходом препятствий, силовой схемой и деталями, напечатанными на 3D-принтере.', category: 'Робототехника' },
  'autonomous-ball-launcher': { title: 'Автономная установка для запуска мячей с компьютерным зрением', description: 'Система с цветовым трекингом в OpenCV, позиционированием сервопривода и регулировкой скорости по расстоянию.', category: 'Встраиваемые системы' },
};
---

<Layout title="Исследования и проекты" description="Проекты Абдурахмона Дадабоева в области компьютерного зрения, инфраструктуры данных, прикладного машинного обучения и встраиваемой инженерии.">
  <header class="projects-header">
    <p class="eyebrow">Исследования и проекты</p>
    <h1>Проекты</h1>
    <p>Исследовательские и программные работы в области компьютерного зрения, инфраструктуры данных, локальных ИИ-систем и встраиваемой инженерии.</p>
  </header>

  <div class="list-header"><span>{sortedProjects.length} проектов</span><span>Основные работы для позиций в ИИ</span></div>

  <h2 class="group-title">Основные проекты</h2>
  <section class="project-list" aria-label="Основные проекты">
    {featuredProjects.map((project) => {
      const slug = getSlug(project);
      const projectCopy = translations[slug] || project.frontmatter;
      return (
        <a href={project.url} class="project-row featured">
          <time>{project.frontmatter.date}</time>
          <div><h2>{projectCopy.title}</h2><p>{projectSummaries.ru[slug]?.result}</p></div>
          <span class="category">{projectCopy.category}</span>
        </a>
      );
    })}
  </section>

  <h2 class="group-title additional-title">Другие проекты</h2>
  <section class="project-list" aria-label="Другие проекты">
    {additionalProjects.map((project) => {
      const slug = getSlug(project);
      const projectCopy = translations[slug] || project.frontmatter;
      return (
        <a href={project.url} class="project-row compact">
          <time>{project.frontmatter.date}</time>
          <div><h2>{projectCopy.title}</h2><p>{projectCopy.description}</p></div>
          <span class="category">{projectCopy.category}</span>
        </a>
      );
    })}
  </section>

  <style>
    .projects-header { max-width: 48rem; padding-bottom: 2.2rem; }
    .projects-header h1 { margin-bottom: 0.5rem; }
    .projects-header > p:last-child { font-size: 1.05rem; }
    .list-header { display: flex; justify-content: space-between; margin-bottom: 0.9rem; color: var(--ink-muted); font-size: 0.84rem; }
    .group-title { margin: 1.6rem 0 0.9rem; font-size: 1.25rem; }
    .additional-title { margin-top: 3rem; }
    .project-list { display: grid; gap: 0.85rem; }
    .project-row { display: grid; grid-template-columns: 8rem minmax(0, 1fr) 10rem; gap: 1.5rem; align-items: start; padding: 1.4rem; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); }
    .project-row.featured { box-shadow: var(--shadow-md); }
    .project-row.compact { padding-block: 1.1rem; }
    .project-row:hover h2 { color: var(--accent); }
    .project-row time, .category { color: var(--ink-muted); font-size: 0.84rem; }
    .category { text-align: right; }
    .project-row h2 { margin-bottom: 0.3rem; font-size: 1.18rem; }
    .project-row p { max-width: 42rem; font-size: 0.96rem; }
    .project-row ul { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; margin-top: 0.45rem; list-style: none; }
    .project-row li { color: var(--ink-muted); font-size: 0.8rem; }
    @media (max-width: 680px) { .project-row { grid-template-columns: 1fr; gap: 0.3rem; } .category { grid-row: 1; text-align: left; } .project-row time { grid-row: 1; justify-self: end; } }
  </style>
</Layout>
