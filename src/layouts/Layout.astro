---
import '../styles/global.css';
import { projectResultDocuments, projectSummaries } from '../data/projectSummaries';
import { EMAIL, formatMonth, getLocale, links, localePath, ui } from '../i18n/site';

interface Props {
  title?: string;
  description?: string;
  frontmatter?: {
    title: string;
    description?: string;
    date?: string;
    category?: string;
    tags?: string[];
  };
}

const { title: explicitTitle, description: explicitDescription, frontmatter } = Astro.props;

const pathname = Astro.url.pathname;
const locale = getLocale(pathname);
const copy = ui[locale];

const siteName = 'Abdurakhmon Dadaboev';
const pageTitle = explicitTitle || frontmatter?.title || siteName;
const description = explicitDescription || frontmatter?.description || copy.siteDescription;
const isHomeTitle = [siteName, '다다버예브 압두라흐먼', 'Абдурахмон Дадабоев'].includes(pageTitle);
const documentTitle = isHomeTitle ? `${pageTitle} (Alex)` : `${pageTitle} · ${siteName}`;

const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(pathname, siteOrigin);
const basePath = pathname.replace(/^\/(?:ko|ru)(?=\/|$)/, '') || '/';
const localePaths = {
  en: basePath,
  ko: localePath('ko', basePath),
  ru: localePath('ru', basePath),
};
const languages = [
  { code: 'en', label: 'EN' },
  { code: 'ko', label: 'KO' },
  { code: 'ru', label: 'RU' },
] as const;

const isProjectDetail = /\/research-and-projects\/[^/]+\/?$/.test(pathname);
const isEssayDetail = /\/essays\/[^/]+\/?$/.test(pathname);
const slug = pathname.split('/').filter(Boolean).at(-1);
const projectSummary = isProjectDetail && slug ? projectSummaries[locale][slug] : undefined;
const projectResultDocument = isProjectDetail && slug ? projectResultDocuments[slug] : undefined;
const summaryKeys = ['challenge', 'role', 'result', 'status'] as const;

const backLink = isProjectDetail
  ? { href: localePath(locale, '/research-and-projects'), label: copy.backToProjects }
  : isEssayDetail
    ? { href: localePath(locale, '/essays'), label: copy.backToEssays }
    : undefined;

const articleMeta = [frontmatter?.category, formatMonth(frontmatter?.date, locale)].filter(Boolean).join(' · ');

const isCurrent = (path: string) => pathname === path || pathname.startsWith(`${path}/`);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1114" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={new URL(localePaths.en, siteOrigin)} />
    <link rel="alternate" hreflang="ko" href={new URL(localePaths.ko, siteOrigin)} />
    <link rel="alternate" hreflang="ru" href={new URL(localePaths.ru, siteOrigin)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePaths.en, siteOrigin)} />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={isProjectDetail || isEssayDetail ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/images/home-portrait.jpg', siteOrigin)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {locale === 'ko' && (
      <link
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
        rel="stylesheet"
        crossorigin="anonymous"
      />
    )}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <a class="skip-link" href="#content">{copy.skip}</a>

    <header class="site-header">
      <div class="container nav-container">
        <a href={localePath(locale)} class="brand" aria-label={`${siteName} · ${copy.homeLabel}`}>
          <span class="brand-mark bbox" aria-hidden="true">AD</span>
          <span class="brand-name">{siteName}</span>
        </a>

        <nav class="site-nav" aria-label={copy.navLabel}>
          <ul>
            {copy.nav.map((item) => (
              <li><a href={item.href} class={isCurrent(item.href) ? 'active' : undefined} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>

        <div class="header-actions">
          <div class="language-switcher" role="group" aria-label={copy.languageLabel}>
            {languages.map((language) => (
              <a
                class:list={['language-switch', { active: locale === language.code }]}
                href={localePaths[language.code]}
                hreflang={language.code}
                lang={language.code}
                aria-current={locale === language.code ? 'true' : undefined}
              >
                {language.label}
              </a>
            ))}
          </div>
          <button class="theme-toggle" type="button" aria-label={copy.themeLabel} title={copy.themeLabel} data-theme-toggle>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="content" class="container">
      {frontmatter ? (
        <article class="prose article-shell">
          {backLink && <a class="back-link" href={backLink.href}><span aria-hidden="true">←</span> {backLink.label}</a>}
          <header class="article-heading">
            {articleMeta && <p class="eyebrow">{articleMeta}</p>}
            <h1>{frontmatter.title}</h1>
            {frontmatter.description && <p class="article-lede">{frontmatter.description}</p>}
            {frontmatter.tags && frontmatter.tags.length > 0 && (
              <div class="article-meta">
                {frontmatter.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            )}
          </header>
          {projectSummary ? (
            <>
              <section class="project-overview" aria-label={copy.summaryLabel}>
                {summaryKeys.map((key) => (
                  <div class:list={['project-overview-item', `project-overview-${key}`]}>
                    <h2>{copy.summary[key]}</h2>
                    <p>{projectSummary[key]}</p>
                    {key === 'result' && projectResultDocument && (
                      <a class="project-evidence-link" href={projectResultDocument.href} target="_blank" rel="noopener noreferrer" type="application/pdf">
                        {projectResultDocument.label[locale]}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M14 3h7v7M21 3l-9 9M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5" />
                        </svg>
                      </a>
                    )}
                  </div>
                ))}
              </section>
              <details class="technical-details">
                <summary>{copy.details}</summary>
                <div class="technical-content"><slot /></div>
              </details>
            </>
          ) : (
            <slot />
          )}
        </article>
      ) : (
        <slot />
      )}
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-note">
          <a href={localePath(locale)} class="footer-name">{siteName}</a>
          <p>{copy.footerRole} {copy.footerCta}</p>
        </div>
        <nav class="footer-links" aria-label={copy.externalLinks}>
          <a href={`mailto:${EMAIL}`}>{copy.email}</a>
          <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={links.kaggle} target="_blank" rel="noopener noreferrer">Kaggle</a>
          <a href={localePath(locale, '/books')}>{copy.reading}</a>
        </nav>
      </div>
      <div class="container footer-bottom mono">
        <span>© {year} {siteName}</span>
        <span>{copy.builtWith}</span>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
