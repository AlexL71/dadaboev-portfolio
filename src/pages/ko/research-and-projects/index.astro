---
import Layout from '../../../layouts/Layout.astro';

const projects = Object.values(import.meta.glob('./*.md', { eager: true })) as any[];
const sortedProjects = projects.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
const translations: Record<string, { title: string; description: string; category: string }> = {
  'north-american-road-data': { title: '북미 도로 데이터 구축 및 Auto-Labeling', description: 'Mapillary 수집, DINOv3 특징 벡터, FAISS 유사도 검색, 수동 검수 도구를 연결한 도로 이미지 구축 파이프라인입니다.', category: '컴퓨터 비전 인프라' },
  'amorphous-bottleneck': { title: '비정형 이상 탐지를 위한 재현율 최적화 앙상블', description: '낮은 대비와 불규칙한 형태를 가진 이상 객체를 안정적으로 찾기 위한 데이터 중심 앙상블 연구입니다.', category: '모델 아키텍처' },
  'omr-htr-digitization': { title: '오프라인 시험지 OMR·OCR 시스템', description: '시험지 정렬, 학생 연결, 답안 추출, 문자 인식, 결과 저장을 하나의 오프라인 흐름으로 구현합니다.', category: '응용 AI 시스템' },
  'road-damage-detection': { title: '도로 손상 세그멘테이션 및 심각도 분류', description: '불규칙한 균열을 폴리곤 마스크로 표현하고 탐지와 심각도 분류를 연결한 성능 인증 비전 파이프라인입니다.', category: '컴퓨터 비전' },
  'text-mining-fundamentals': { title: 'Python 텍스트 마이닝 실습 과정', description: '크롤링, 사전 분석, 토픽 모델링, LSTM 감성 분석을 다루는 프로젝트 중심 교육 자료입니다.', category: '자연어 처리' },
  'semantic-segmentation-modality-reduction': { title: '지식 증류 기반 경량 시맨틱 세그멘테이션', description: 'RGB·NIR·LiDAR 교사 모델의 지식을 RGB 전용 학생 모델로 전달해 센서 요구사항을 줄입니다.', category: '컴퓨터 비전' },
  'daily-doer-agent': { title: 'DailyDoer 텔레그램 자동화 에이전트', description: '일정, 이메일, 뉴스, 음성 명령을 하나의 대화형 인터페이스로 연결한 Python 기반 에이전트입니다.', category: '대화형 AI' },
  'local-llm-assistant': { title: '로컬 LLM 모바일 어시스턴트', description: 'PC에서 실행되는 로컬 언어 모델을 모바일 앱과 연결한 개인용 오프라인 AI 어시스턴트입니다.', category: '로컬 AI' },
  'autonomous-hexapod-robot': { title: '18자유도 헥사포드 로봇', description: '초음파 장애물 회피, 보행 제어, 전원 회로, 3D 프린팅 부품을 통합한 6족 보행 로봇입니다.', category: '로보틱스' },
  'autonomous-ball-launcher': { title: '비전 기반 자동 공 발사기', description: 'OpenCV 색상 추적, 서보 위치 제어, 초음파 거리 기반 모터 출력을 결합한 자동 발사 시스템입니다.', category: '임베디드 시스템' },
};
---

<Layout title="연구 및 프로젝트" description="다다버예브 압두라흐먼의 컴퓨터 비전, 데이터 시스템, 응용 머신러닝, 임베디드 엔지니어링 프로젝트입니다.">
  <section class="projects-hero">
    <div><p class="eyebrow">연구 및 프로젝트</p><h1>시스템, 실험, 그리고 배운 점.</h1></div>
    <p>컴퓨터 비전, 데이터 구축, 모델 경량화, 오프라인 AI, 자연어 처리, 임베디드 시스템 분야의 주요 작업입니다.</p>
  </section>

  <div class="project-count"><span>프로젝트 {String(sortedProjects.length).padStart(2, '0')}개</span><span>최신순</span></div>

  <section class="projects-grid">
    {sortedProjects.map((project, index) => {
      const slug = project.url.split('/').filter(Boolean).at(-1) as string;
      const copy = translations[slug] || project.frontmatter;
      return (
        <a href={project.url} class:list={['project-card', index === 0 && 'featured']}>
          <div class="project-meta"><span>{String(index + 1).padStart(2, '0')}</span><span>{project.frontmatter.date}</span></div>
          <div>
            <span class="badge">{copy.category}</span>
            <h2>{copy.title}</h2>
            <p>{copy.description}</p>
          </div>
          <div class="project-footer">
            <div>{project.frontmatter.tags?.slice(0, 3).map((tag: string) => <span>{tag}</span>)}</div>
            <span class="arrow" aria-hidden="true">↗</span>
          </div>
        </a>
      );
    })}
  </section>

  <style>
    .projects-hero { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr); gap: clamp(2rem, 7vw, 7rem); align-items: end; padding-block: 1.5rem clamp(4rem, 8vw, 6.5rem); }
    .projects-hero h1 { max-width: 11ch; word-break: keep-all; }
    .projects-hero > p { font-size: 1.05rem; line-height: 1.82; word-break: keep-all; }
    .project-count { display: flex; justify-content: space-between; padding-block: 0.8rem; border-block: 1px solid var(--line); color: var(--ink-muted); font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; }
    .projects-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; padding-top: 1rem; }
    .project-card { min-height: 24rem; display: flex; flex-direction: column; padding: clamp(1.4rem, 4vw, 2.2rem); border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--surface); transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition); }
    .project-card:hover { transform: translateY(-3px); border-color: var(--line-strong); box-shadow: var(--shadow-md); }
    .project-card.featured { background: var(--accent-soft); border-color: #c9e6d6; }
    .project-meta { display: flex; justify-content: space-between; margin-bottom: 2.7rem; color: var(--ink-muted); font-family: var(--font-mono); font-size: 0.7rem; }
    .project-card h2 { max-width: 18ch; margin: 0.9rem 0 0.9rem; font-size: clamp(1.35rem, 3vw, 1.85rem); word-break: keep-all; }
    .project-card p { max-width: 34rem; font-size: 0.9rem; word-break: keep-all; }
    .project-footer { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-top: auto; padding-top: 2rem; }
    .project-footer > div { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .project-footer > div span { color: var(--ink-muted); font-size: 0.68rem; }
    .arrow { color: var(--ink); font-size: 1.2rem; }
    @media (max-width: 760px) { .projects-hero, .projects-grid { grid-template-columns: 1fr; } .project-card { min-height: 21rem; } }
  </style>
</Layout>
